{
  "name": "@gravirei/reis",
  "version": "3.0.0",
  "description": "Roadmap Execution & Implementation System v2.0 - Wave-based execution with checkpoints, metrics, and visualization for Atlassian Rovo Dev",
  "main": "lib/install.js",
  "bin": {
    "reis": "bin/reis.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');for(const f of ['src/index.js','src/types/index.js','src/types/config.js','src/types/state.js','src/types/plan.js','src/types/cycle.js','src/types/gates.js','src/types/debug.js','src/types/parallel.js']) fs.rmSync(f,{force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --selectProjects suite --silent",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "postinstall": "node lib/install.js --silent",
    "test:perf": "jest --selectProjects perf --silent"
  },
  "keywords": [
    "reis",
    "roadmap",
    "execution",
    "implementation",
    "rovo",
    "dev",
    "systematic",
    "development",
    "gsd",
    "workflow",
    "cli",
    "project-management",
    "planning",
    "subagents",
    "ai-assisted",
    "wave-execution",
    "checkpoints",
    "metrics",
    "visualization"
  ],
  "author": "Gravirei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gravirei/reis.git"
  },
  "bugs": {
    "url": "https://github.com/Gravirei/reis/issues"
  },
  "homepage": "https://github.com/Gravirei/reis#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true,
  "files": [
    "bin/reis.js",
    "lib/install.js",
    "lib/install.d.ts",
    "lib/uninstall.js",
    "lib/uninstall.d.ts",
    "commands",
    "reis",
    "hooks",
    "agents",
    "templates",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "inquirer": "^8.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/inquirer": "^9.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "playwright": "^1.58.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
